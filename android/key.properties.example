# Copy to android/key.properties and fill in. That file is gitignored: it holds
# the upload key's passwords and must never be committed.
#
# storeFile is resolved relative to the android/ directory, so an absolute path
# or something like ../upload-keystore.jks (outside the repo) both work.
storeFile=/absolute/path/to/upload-keystore.jks
storePassword=
keyAlias=
keyPassword=
